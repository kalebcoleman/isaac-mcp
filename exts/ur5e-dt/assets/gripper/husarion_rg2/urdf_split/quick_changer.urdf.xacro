<?xml version="1.0"?>
<!-- Standalone OnRobot Quick-Changer coupler (15mm) — its OWN part. quick_changer_link is the root;
     tool_mount is the tool-side face (+15mm) the gripper welds onto. In Isaac the coupler is welded
     onto the UR5e flange (wrist_3) and the bare RG2 (rg2_gripper.urdf.xacro) is welded onto tool_mount,
     so the coupler is the SOLE structural adapter — one adapter, not two. -->
<robot name="onrobot_quick_changer" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find onrobot_rg2_sim_control)/urdf/onrobot_quick_changer.urdf.xacro" />
  <!-- parent_link omitted => quick_changer_link is the root (standalone coupler). -->
  <xacro:onrobot_quick_changer thickness="0.015" />
</robot>
