# Shared ROS 2 / DDS environment for the simulator and its ROS clients.
# ROS_DOMAIN_ID, interface isolation and DDS settings must agree across the
# participating processes for discovery to work. This does not configure the
# driver's TCP connection to URSim or a robot.

# Domain — MUST match every ROS client. Respects an already-exported value.
export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"

# Interface isolation — MUST match the consumer (single-host, loopback only).
export ROS_LOCALHOST_ONLY=1

# DDS vendor — homogeneous with the consumer + Isaac (no cross-vendor actions).
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Cyclone profile (AllowMulticast off, SharedMemory off), stored next to this file.
_ISAAC_DDS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CYCLONEDDS_URI="file://${_ISAAC_DDS_DIR}/cyclonedds.xml"
unset _ISAAC_DDS_DIR

# Source any client-specific overlays in those clients, not in the simulator:
# incompatible Python packages can shadow Isaac Sim's bundled ROS bindings.
